<?xml version="1.0" encoding="utf-8"?>
<!-- Archived dead file. The package name has been replaced with a neutral placeholder. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.covernotifier"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="30"/>

    <application
        android:label="Cover Notifier"
        android:icon="@android:drawable/sym_def_app_icon"
        android:allowBackup="false">

        <activity
            android:name=".SetupActivity"
            android:exported="true"
            android:label="Cover Notifier Setup">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <service
            android:name=".MessageRelayListener"
            android:exported="false"
            android:label="Cover screen message relay"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService"/>
            </intent-filter>
        </service>

    </application>
</manifest>
